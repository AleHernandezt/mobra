---
import Card from "../components/Card.astro";
import Card2 from "../components/Card2.astro";
import Titulo from "../components/Titulo.astro";
---

<section
  class="p-16 pt-20 flex flex-col justify-start items-center relative"
  id="Services"
>
  <Titulo title="Services & Pricing" subtitle="" />

  <div class="flex gap-10">
    <Card
      title="For individuals"
      subtitle="Basic"
      description="MOBRA BASIC PACKAGE"
      actionTitle="80$"
      includes={[
        "Exterior wash",
        "Wheel polishing",
        "Wheel silicone",
        "Vacuuming",
      ]}
      action="Get Started"
      image="img4.jpg"
      className="box"

    />

    <Card
      title="For Startups"
      subtitle="Pro"
      description="MOBRA PRO PACKAGE"
      actionTitle="150$"
      includes={[
        "MOBRA BASIC PACKAGE",
        "Dashboard detailing",
        "Leather and fabric moisture and protection",
        "Badge polishing",
      ]}
      action="Get Started"
      image="img5.jpg"
      className="box"
    />
    <Card
      title="For Big Companies"
      subtitle="Enterprise"
      description="MOBRA PREMIUM PACKAGE "
      actionTitle="300$"
      includes={[
        "MOBRA PRO PACKAGE",
        "Exterior polishing",
        "Coating",
        "Engine detailing",
        "Spotless interior",
      ]}
      action="Get Started"
      image="img6.jpg"
      className="box"

    />
  </div>
  
</section>

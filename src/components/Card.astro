---
import BtnCard2 from './BtnCard2.astro';

interface Props {
  image: string;
  title: string;
  subtitle: string;
  description: string;
  actionTitle: string;
  includes: string[];
  action: string;
  className?: string; // Añadido para clases adicionales
  id?: string; // Añadido para ID
  width?: string; // Añadido para ancho

}

const { image, title, subtitle, description, actionTitle, includes, action, className = '', id, width = 'w-80'} = Astro.props;
---

<section id={id} class={`p-4 pt-8 ${width} bg-white rounded-lg shadow-md transition duration-500 ease-in-out scale-100 hover:scale-110 ${className}`}>
  <div class="flex flex-row p-2 transition duration-500 ease-in-out">
    <img src={image} alt="Imagen" class="w-10 h-10 object-cover rounded" />
    <div class="ml-2">
      <h3 class="text-lg font-bold text-black">{title}</h3>
      <h4 class="text-sm text-black">{subtitle}</h4>
    </div>
  </div>
  <p class="text-gray-500 p-2 py-4 transition duration-500 ease-in-out text-xs">{description}</p>
  <h3 class="text-4xl font-bold p-2 py-4 text-black transition duration-500 ease-in-out">{actionTitle}</h3>
  <h4 class="p-2 text-black transition duration-500 ease-in-out">What's included</h4>
  <div class="flex flex-col p-2 transition duration-500 ease-in-out py-10">
    {includes.map((include) => (
      <div class="flex items-center">
        <svg class="w-5 h-5 text-black mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <p class="text-sm text-black">{include}</p>
      </div>
    ))}
  </div>
  <BtnCard2 class="mx-4 mb-4">{action}</BtnCard2>
</section>
<style>
#card2 { 
  background-color: #FBBF24; 
} 

#card1:hover ~ #card2, 
#card3:hover ~ #card2 { 
  background-color: white; 
} 

#card1:hover, 
#card3:hover { 
  background-color: #FBBF24; 
}
</style>